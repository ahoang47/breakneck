# ==============================================================================
# Breakneck — .gitattributes (Text Normalization + Git LFS for Game-Ready Assets)
# ==============================================================================

# --- Default text normalization ---
* text=auto eol=lf

# --- Godot & Code (always LF text) ---
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.gdshader  text eol=lf
*.gdshaderinc text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.gdignore  text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.sh        text eol=lf

# --- Git LFS: Game-ready binary exports only ---
# 3D models & binary buffers (prefer .glb; .gltf JSON stays text)
*.glb   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text

# Textures & Images
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text

# Audio (game-ready exports only; no DAW projects/stems)
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text

# Fonts & Godot binary resources
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.res   filter=lfs diff=lfs merge=lfs -text
*.scn   filter=lfs diff=lfs merge=lfs -text
